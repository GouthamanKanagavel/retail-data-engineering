{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSalesPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::retail-data-engineering-1790670224",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "sales",
            "sales/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadSalesObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::retail-data-engineering-1790670224/sales/*"
    }
  ]
}
